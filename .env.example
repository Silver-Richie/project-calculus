# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Masuk dengan Google: console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID (Web application). Authorized redirect URI:
#   http://127.0.0.1:8000/accounts/google/login/callback/
# Kosongkan jika belum punya; tombol Google tidak akan tampil.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database produksi (PostgreSQL). Biarkan PRODUCTION=False untuk SQLite lokal.
PRODUCTION=False
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
SCHEMA=public
