# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Masuk dengan Google: console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID (Web application). Authorized redirect URI (daftarkan keduanya):
#   http://127.0.0.1:8000/accounts/google/login/callback/
#   https://USERNAME.pythonanywhere.com/accounts/google/login/callback/
# Kosongkan jika belum punya; tombol Google tidak akan tampil.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Hanya di server (PythonAnywhere). Di laptop biarkan PRODUCTION=False. ----
PRODUCTION=False
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=USERNAME.pythonanywhere.com
# PythonAnywhere memakai WSGI (tanpa WebSocket), jadi duel dimatikan di sana.
DUEL_ENABLED=False

# Database: tanpa isian = SQLite (db.sqlite3), cukup untuk akun gratis.
# Hanya untuk akun berbayar dengan MySQL: hapus tanda # di bawah, lalu `pip install mysqlclient`.
# DB_NAME='USERNAME$calculus'   # tanda kutip tunggal: $ dibaca apa adanya
# DB_USER=USERNAME
# DB_PASSWORD=
# DB_HOST=USERNAME.mysql.pythonanywhere-services.com
